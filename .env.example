# obsidian latex suite output paths
OBSIDIAN_SNIPPETS_PATH="/path/to/your/obsidian/snippets.js"
OBSIDIAN_VARIABLES_PATH="/path/to/your/obsidian/variables.json"

# vscode hypersnips output path(s)
# you can specify a single path:
# LATEX_SNIPPETS_PATH="/path/to/your/latex.hsnips"
#
# or multiple paths separated by commas (useful for vscode/cursor, latex/md)
LATEX_SNIPPETS_PATHS="/path/to/vscode/latex.hsnips,/path/to/vscode/markdown.hsnips,/path/to/cursor/latex.hsnips"

# neovim luasnip output path(s); same convention:
# NEOVIM_SNIPPETS_PATH="/path/to/your/nvim/luasnippets/tex.lua"
NEOVIM_SNIPPETS_PATHS="/path/to/luasnippets/tex.lua,/path/to/luasnippets/markdown.lua"
